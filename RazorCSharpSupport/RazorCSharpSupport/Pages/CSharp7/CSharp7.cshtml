@page
@model RazorCSharpSupport.Pages.CSharp7Model
@using System
@{
    // C# 7.0: Out variable declaration
    bool TryParseInt(string input, out int result)
    {
        return int.TryParse(input, out result);
    }

    // C# 7.0: Tuples and deconstruction
    (int sum, int product) Calculate(int a, int b)
    {
        return (a + b, a * b);
    }

    // C# 7.0: Pattern matching with 'is'
    string TypeCheck(object obj)
    {
        if (obj is int i)
            return $"Integer: {i}";
        if (obj is string s)
            return $"String: {s}";
        return "Unknown type";
    }

    // C# 7.0: Pattern matching in switch
    string SwitchType(object obj)
    {
        switch (obj)
        {
            case int i:
                return $"int: {i}";
            case string s:
                return $"string: {s}";
            default:
                return "other";
        }
    }

    // C# 7.0: Local functions
    int Fibonacci(int n)
    {
        int Fib(int x)
        {
            if (x <= 1) return x;
            return Fib(x - 1) + Fib(x - 2);
        }
        return Fib(n);
    }

    // C# 7.0: Expression-bodied members
    int Square(int x) => x * x;

    // C# 7.0: Throw expressions
    string GetNonNull(string value) => value ?? throw new ArgumentNullException(nameof(value));

    // C# 7.0: Digit separators and binary literals
    int GetBinaryLiteral() => 0b1010_1010;

    // C# 7.0: Ref returns and locals
    int[] numbers = { 1, 2, 3, 4, 5 };
    ref int GetNumberRef(int index) => ref numbers[index];

    // C# 7.0: Generalized async return types - ValueTask examples
    async ValueTask<int> CalculateValueAsync(int value)
    {
        // ValueTask allows for efficient async operations that may complete synchronously
        if (value < 10)
        {
            // Can return synchronously without Task allocation overhead
            return value * 2;
        }
        
        // Simulate async work for larger values
        await Task.Delay(1);
        return value * 3;
    }

    async ValueTask ProcessDataAsync()
    {
        // ValueTask (without generic parameter) for async void-like operations
        // More efficient than Task when operation often completes synchronously
        await Task.Delay(1);
    }

    int outResult;
    bool parsed = TryParseInt("123", out outResult);
    (int sum, int product) = Calculate(3, 4);
    string typeCheckInt = TypeCheck(42);
    string typeCheckString = TypeCheck("hello");
    string switchTypeInt = SwitchType(99);
    string switchTypeString = SwitchType("world");
    int fib5 = Fibonacci(5);
    int square7 = Square(7);
    string nonNull = GetNonNull("not null");
    int binary = GetBinaryLiteral();
    (int foo, int bar) = Calculate(5, 6);
    
    // Demonstrate ValueTask usage
    int valueTaskResult = await CalculateValueAsync(5);
    int valueTaskResultAsync = await CalculateValueAsync(15);
    await ProcessDataAsync();
    
    // Call the PageModel's ValueTask methods
    string cachedData = await Model.GetCachedDataAsync();
    await Model.LogOperationAsync();
    string taskData = await Model.GetDataWithTaskAsync();
    
    // Ref operations must be after async operations
    ref int refNum = ref GetNumberRef(2);
}

<h2>C# 7.0 Feature Demos</h2>
<ul>
    <li><b>Out variable declaration:</b> Parsed: @parsed, Result: @outResult</li>
    <li><b>Tuples and deconstruction:</b> Sum: @sum, Product: @product</li>
    <li><b>Pattern matching (is):</b> Int: @typeCheckInt, String: @typeCheckString</li>
    <li><b>Pattern matching (switch):</b> Int: @switchTypeInt, String: @switchTypeString</li>
    <li><b>Local functions (Fibonacci 5):</b> @fib5</li>
    <li><b>Expression-bodied member (Square 7):</b> @square7</li>
    <li><b>Throw expressions (non-null):</b> @nonNull</li>
    <li><b>Binary literal:</b> @binary</li>
    <li><b>Ref return (index 2):</b> @refNum</li>
    <li><b>Generalized async return types (ValueTask):</b> 
        <ul>
            <li>Small value (sync): @valueTaskResult</li>
            <li>Large value (async): @valueTaskResultAsync</li>
            <li>Cached data from PageModel: @cachedData</li>
            <li>Task method for comparison: @taskData</li>
        </ul>
    </li>
</ul>

<div style="margin-top: 20px; padding: 15px; background-color: #f0f8ff; border-left: 4px solid #0066cc;">
    <h4>C# 7.0 Generalized Async Return Types Explanation</h4>
    <p><strong>ValueTask&lt;T&gt;</strong> and <strong>ValueTask</strong> were introduced in C# 7.0 as alternatives to Task&lt;T&gt; and Task.</p>
    <p><strong>Benefits:</strong></p>
    <ul>
        <li>Reduced memory allocation when operations complete synchronously</li>
        <li>Better performance for frequently-called async methods that often have cached results</li>
        <li>Can return completed results without Task overhead</li>
    </ul>
    <p><strong>When to use:</strong> Methods that frequently return cached or pre-computed values, but occasionally need to perform async work.</p>
</div>

<div style="margin-top: 30px; padding: 15px; background-color: #f9f9f9; border-left: 4px solid #28a745;">
    <h3>C# 7.0 Features with Inline Razor Expressions</h3>
    
    <h4>Tuples in Inline Expressions</h4>
    <p>Create and deconstruct tuples directly in Razor:</p>
    <ul>
        <li>Simple tuple: @((10, "Hello").Item1) and @((10, "Hello").Item2)</li>
        <li>Named tuple elements: @((age: 25, name: "John").age) years old, name is @((age: 25, name: "John").name)</li>
        <li>Tuple deconstruction: @{var (x, y) = (100, 200);} X: @x, Y: @y</li>
    </ul>
    
    <h4>Pattern Matching with 'is' in Inline Expressions</h4>
    <p>Use pattern matching directly in expressions:</p>
    <ul>
        <li>Check if object is int: @((object)42 is int val ? $"Integer: {val}" : "Not an integer")</li>
        <li>Check if string is not null/empty: @(("test" is string s && !string.IsNullOrEmpty(s)) ? $"Valid string: {s}" : "Invalid")</li>
        <li>Pattern match with condition: @((object)15 is int num && num > 10 ? $"Large number: {num}" : "Small or not a number")</li>
    </ul>
    
    <h4>Expression-bodied Members (Lambda-style)</h4>
    <p>Use expression-bodied syntax in inline expressions:</p>
    <ul>
        <li>Simple calculation: @(new Func<int, int>(x => x * x * x)(4)) (cube of 4)</li>
        <li>Conditional expression: @(new Func<int, string>(age => age >= 18 ? "Adult" : "Minor")(21))</li>
        <li>String manipulation: @(new Func<string, string>(name => $"Hello, {name.ToUpper()}!")("world"))</li>
    </ul>
    
    <h4>Throw Expressions with Null-Coalescing</h4>
    <p>Use throw expressions for null checking:</p>
    <ul>
        <li>Null-coalescing with throw: @(DateTime.Now.ToString() ?? throw new InvalidOperationException("Date is null"))</li>
        <li>Parameter validation: @((new Func<string, string>(input => input ?? throw new ArgumentNullException(nameof(input))))("Valid input"))</li>
    </ul>
    
    <h4>Discards in Inline Expressions</h4>
    <p>Use discards to ignore unwanted values:</p>
    <ul>
        <li>Tuple with discard: @{var (first, _) = (100, 200);} First value: @first (second discarded)</li>
        <li>TryParse with discard: @(int.TryParse("123", out _) ? "Valid number format" : "Invalid")</li>
        <li>Multiple discards: @{var (a, _, c, _) = (1, 2, 3, 4);} Values: @a and @c (others discarded)</li>
    </ul>
    
    <h4>Binary Literals and Digit Separators</h4>
    <p>Use new numeric literal formats:</p>
    <ul>
        <li>Binary literal: @(0b1010_1010) (decimal: @Convert.ToInt32("10101010", 2))</li>
        <li>Large number with separators: @(1_000_000) (one million)</li>
        <li>Hex with separators: @(0xFF_FF_FF_FF) (max uint32)</li>
    </ul>
</div>

